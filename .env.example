# --- AI ---
ANTHROPIC_API_KEY=

# --- Data mode: "demo" uses the seeded demo dataset; "live" calls the real APIs below ---
DATA_MODE=demo
PORT=3000

# --- Shopify (Admin GraphQL API, custom app token) ---
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# --- Google Ads (REST googleAds:searchStream) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_ACCESS_TOKEN=

# --- Meta Marketing API ---
META_AD_ACCOUNT_ID=act_000000000
META_ACCESS_TOKEN=

# --- Cost model (anything Shopify does not know) ---
PAYMENT_FEE_PCT=0.029
PAYMENT_FEE_FIXED=0.30
PICK_PACK_PER_ORDER=3.20
RETURN_HANDLING_PER_UNIT=6.50

# --- Proactive monitor ---
MONITOR_INTERVAL_MINUTES=60
SLACK_WEBHOOK_URL=
# Keeps sent-alert state between one-shot monitor runs
MONITOR_STATE_FILE=.monitor-state.json

# --- Vercel ---
# Max seconds for the /api/chat function (60 fits all plans; raise on Pro)
VERCEL_FUNCTION_MAX_DURATION=60
MONITOR_LANG=en
